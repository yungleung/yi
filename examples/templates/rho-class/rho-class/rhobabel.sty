%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% --------------------------------------------------------
% Keep This Package!
% --------------------------------------------------------
% This package provides multilingual support, with English
% and Spanish enabled by default. It defines some document
% labels and can be extended to other languages if needed.
% --------------------------------------------------------
% Do not remove it from 'rho.cls' file. Removal may cause
% undefined commands or compilation errors.
% --------------------------------------------------------
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%----------------------------------------------------------
% Package configuration
%----------------------------------------------------------

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rho-class/rhobabel}[15/04/2026 Rhobabel LaTeX2e package]

% `iflang`'s \iflanguage tests whether a language is loaded, not whether it is
% selected. Compare babel's current language instead so loading Spanish as an
% alternate does not switch an English document's labels.
\newcommand{\ifcurrentspanish}[2]{%
    \ifdefstring{\languagename}{spanish}{#1}{#2}%
}

%----------------------------------------------------------
% Label for "keywords"
%----------------------------------------------------------

\newcommand{\keywordname}{{\keywordheadfont{Keywords:\nobreakspace}}}

%----------------------------------------------------------

% Tip: Change manually the second {} if using another language

%----------------------------------------------------------
% Language labels for cross-references
%----------------------------------------------------------

% Cross-reference label for figure
\newcommand{\figlabel}{%
    \ifcurrentspanish{%
        {Fig.}%
    }{%else
        {Fig.}%
    }%
}

% Cross-reference label for figures
\newcommand{\figslabel}{%
    \ifcurrentspanish{%
        {Figs.}%
    }{%else
        {Figs.}%
    }%
}

% Cross-reference label for tables
\newcommand{\tablabel}{%
    \ifcurrentspanish{%
        {Tabla}%
    }{%else
        {Table}%
    }%
}

% Caption and cross-reference label for codes
\newcommand{\captionlabelcode}{%
    \ifcurrentspanish{%
        {C\'odigo}%
    }{%else
        {Code}%
    }%
}

% Cross-reference label for equations
\newcommand{\eqlabel}{%
    \ifcurrentspanish{%
        {Ecuaci\'on}%
    }{%else
        {Equation}%
    }%
}

%----------------------------------------------------------
% Conjunction used between author names
%----------------------------------------------------------

\newcommand{\andlanguage}{%
    \ifcurrentspanish{%
        { y }%
    }{%else
        { and }%
    }%
}

%----------------------------------------------------------
% Translatable titles for custom environments
%----------------------------------------------------------

% Info environment
\newcommand{\infolanguage}{%
    \ifcurrentspanish{%
        {Informaci\'on}%
    }{%else
        {Information}%
    }%
}

% Note environment
\newcommand{\notelanguage}{%
    \ifcurrentspanish{%
        {Nota}%
    }{%else
        {Note}%
    }%
}

%----------------------------------------------------------

\endinput
